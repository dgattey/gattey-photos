# Local filesystem storage (no Vercel tokens required)
GATTEY_LOCAL_STORAGE=1
SYNC_PASSWORD=change-me-family-only
# Vercel Cron + ./scripts/local-advance-cron.sh (Bearer on /api/cron/advance-current)
CRON_SECRET=change-me-cron-only

# Production (remove GATTEY_LOCAL_STORAGE)
# BLOB_READ_WRITE_TOKEN=
# EDGE_CONFIG=https://edge-config.vercel.com/...
# SYNC_PASSWORD=  # or store syncPassword key in Edge Config
# CRON_SECRET=  # required in production; Vercel sends Authorization: Bearer <value>
